# /opt/sb/pulsearr/auth.env on the server (chmod 600). GoTrue's settings that hold secrets or long text.

# Sign-in and invite emails go through Resend's SMTP. pulsearr.com must be verified in Resend first.
GOTRUE_SMTP_HOST=smtp.resend.com
GOTRUE_SMTP_PORT=465
GOTRUE_SMTP_USER=resend
# The Resend API key (the same kind of key as RESEND_API_KEY in the app).
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=hello@pulsearr.com
GOTRUE_SMTP_SENDER_NAME=PulseARR

# Email sign-in with a 6-digit code, good for 1 hour.
GOTRUE_MAILER_OTP_LENGTH=6
GOTRUE_MAILER_OTP_EXP=3600
GOTRUE_RATE_LIMIT_EMAIL_SENT=60

# PulseARR's templates: an https address GoTrue fetches each HTML file from (one per kind). Each template shows
# {{ .Token }} (the code). Leave a line out and GoTrue sends its plain default for that kind.
GOTRUE_MAILER_SUBJECTS_MAGIC_LINK=Your PulseARR sign-in code
GOTRUE_MAILER_SUBJECTS_CONFIRMATION=Your PulseARR sign-in code
GOTRUE_MAILER_SUBJECTS_INVITE=You're invited to PulseARR
GOTRUE_MAILER_SUBJECTS_EMAIL_CHANGE=Confirm your new email for PulseARR
GOTRUE_MAILER_TEMPLATES_MAGIC_LINK=https://app.pulsearr.com/email-templates/magic-link.html
GOTRUE_MAILER_TEMPLATES_CONFIRMATION=https://app.pulsearr.com/email-templates/confirmation.html
GOTRUE_MAILER_TEMPLATES_INVITE=https://app.pulsearr.com/email-templates/invite.html
GOTRUE_MAILER_TEMPLATES_EMAIL_CHANGE=https://app.pulsearr.com/email-templates/email-change.html

# Google sign-in. The OAuth client's redirect address is https://db.pulsearr.com/auth/v1/callback.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://db.pulsearr.com/auth/v1/callback
