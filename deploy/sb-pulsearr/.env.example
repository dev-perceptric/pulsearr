# /docker/sb-pulsearr/.env on the server. Fresh values for PulseARR only, never copied from another stack.
# Match /docker/sb-arrowsterr/.env's variable names and key format: if that file has more names than these (for
# example sb_publishable_ and sb_secret_ keys the gateway reads), add the same ones here.
# make-keys.mjs (next to this file) prints a full set.

# Password for postgres, supabase_admin, supabase_auth_admin and authenticator. Hex, so it is safe in URLs.
POSTGRES_PASSWORD=
# Signs every session token. At least 32 characters. Changing it signs everyone out and needs new keys below.
JWT_SECRET=
# Session token lifetime in seconds.
JWT_EXP=3600
# Long-lived JWTs signed with JWT_SECRET: role anon (browser) and role service_role (server).
ANON_KEY=
SERVICE_ROLE_KEY=
# Only if sb-arrowsterr uses the newer opaque keys: what the app sends as SUPABASE_PUBLISHABLE_KEY and
# SUPABASE_SECRET_KEY, which the gateway swaps for ANON_KEY and SERVICE_ROLE_KEY.
PUBLISHABLE_KEY=
SECRET_KEY=
