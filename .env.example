# PulseARR settings. Copy to .env.local for development. On the VPS, the web app reads /docker/pulsearr-web/.env and
# the worker reads /docker/pulsearr-worker/.env (deploy/README.md). No real values in this file, ever.

# --- Web app ---
# The Supabase-style API for sign-in and data: https://db.pulsearr.com in production, http://127.0.0.1:54321 locally.
SUPABASE_URL=
# The browser key (anon or sb_publishable_, in the format the stack's gateway takes).
SUPABASE_PUBLISHABLE_KEY=
# The server key (service_role or sb_secret_). Server code only, never sent to the browser.
SUPABASE_SECRET_KEY=
# Where the app lives, for links in emails: https://app.pulsearr.com in production.
APP_URL=http://localhost:3000
# Sites allowed to post to /api/waitlist (comma separated): https://pulsearr.com,https://www.pulsearr.com
SITE_ORIGINS=
# Build time only: PostHog project key. Empty means PostHog is off. CI passes the repo variable of the same name.
NEXT_PUBLIC_POSTHOG_KEY=
# Build time only: the commit, for /api/version. CI sets it; leave empty locally.
GIT_SHA=

# --- Web app and worker ---
# Seals stored tokens (AES-256-GCM): base64 of 32 random bytes (openssl rand -base64 32). Set once and never
# rotated without a re-seal script. The web app and the worker must have the same value.
SECRETS_KEY=
# Resend API key. Empty in development means emails are logged, not sent.
RESEND_API_KEY=
# Sender for every email.
EMAIL_FROM=PulseARR <hello@pulsearr.com>
# Claude, for askClaude(). Optional in M0: nothing calls it yet.
ANTHROPIC_API_KEY=
# The platform's Stripe secret key (sk_live_...): trades Stripe App install codes for tokens and refreshes them.
STRIPE_SECRET_KEY=

# --- Web app: Stripe (stripe-app/README.md) ---
# The PulseARR Stripe App's client id (ca_...), from the app's Settings tab. Empty means "Connect Stripe" is off.
STRIPE_APP_CLIENT_ID=
# Signing secret (whsec_...) of the Connect webhook for https://app.pulsearr.com/api/stripe/webhook.
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Worker ---
# Direct Postgres: postgres://postgres:<password>@db:5432/postgres on the sb-pulsearr network in production.
DATABASE_URL=
# How many jobs the worker runs at once (optional).
WORKER_CONCURRENCY=

# --- Tests ---
# A Postgres superuser URL for npm run test:db. Without it the script uses the local Postgres.
DATABASE_URL_TEST=
